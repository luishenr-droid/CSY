# Execucao
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
HOST_IP=

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@servidor:5432/nzn_quiz

# Primeiro administrador Master
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_ALLOWED_DOMAIN=

# Use uma chave longa, aleatoria e exclusiva
PASSWORD_VAULT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Envio de e-mails pelo Resend (opcional)
RESEND_API_KEY=
EMAIL_FROM=NZN Quiz <nao-responda@seu-dominio.com>

# PagBank (opcional)
PAGBANK_TOKEN=
PAGBANK_ENV=sandbox
PAGBANK_WEBHOOK_VERIFICATION=auto
